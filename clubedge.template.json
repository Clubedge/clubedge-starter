            "e2e/jobs.spec.ts"
          ]
        },
        "bullmq": {
          "name": "BullMQ (jobs stored in Redis)",
          "packages": {
            "@clubedge/jobs": "packages/jobs",
            "@clubedge/jobs-bullmq": "packages/jobs-bullmq"
          },
          "requires": {
            "cache": "redis"
          },
          "files": [
            "apps/start/src/components/jobs",
            "apps/start/src/jobs",
            "apps/start/src/nitro/plugins/jobs.ts",
            "apps/start/src/routes/api/jobs",

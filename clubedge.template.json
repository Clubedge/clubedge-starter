            "e2e/jobs.spec.ts"
          ],
          "replace": {
            "apps/web/src/server/jobs.ts": "apps/web/src/server/variants/jobs.bullmq.ts",
            "apps/start/src/server/jobs.ts": "apps/start/src/server/variants/jobs.bullmq.ts"
          }
        },
        "inngest": {
          "name": "Inngest (runs each job by calling the app)",
          "packages": {
            "@clubedge/jobs": "packages/jobs",
            "@clubedge/jobs-inngest": "packages/jobs-inngest"
          },
          "files": [
            "apps/start/src/components/jobs",
            "apps/start/src/jobs",
            "apps/start/src/nitro/plugins/jobs.ts",
            "apps/start/src/routes/api/inngest.ts",
            "apps/start/src/routes/jobs",
            "apps/start/src/server/jobs-forms.ts",
            "apps/start/src/server/jobs.functions.ts",
            "apps/start/src/server/jobs.ts",
            "apps/web/src/app/api/inngest",

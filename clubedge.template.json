{
  "schemaVersion": 4,
  "name": "clubedge-starter",
  "packageManager": "pnpm",
  "siteConfig": "apps/web/src/config/site.json",
  "dockerImage": "clubedge-starter",
  "slots": {
    "framework": {
      "name": "Framework",
      "question": "Which framework should the app use?",
      "path": "apps/web",
      "package": "@clubedge/web",
      "env": {
        "example": ".env.example",
        "target": "apps/web/.env.local"
      },
      "dockerfile": "Dockerfile",
      "roles": ["fullstack", "frontend"],
      "default": "next"
    },
    "api": {
      "name": "API",
      "question": "Which API should the frontend call?",
      "path": "apps/api",
      "package": "@clubedge/api",
      "env": {
        "example": "apps/api/.env.example",
        "target": "apps/api/.env.local"
      },
      "dockerfile": "apps/api/Dockerfile",
      "roles": ["api"],
      "siteConfig": "apps/api/src/config/site.json",
      "packages": {
        "@clubedge/contract": "packages/contract"
      }
    }
  },
  "modules": [
    "auth",
    "storage",
    "cache",
    "email",
    "payments",
    "jobs",
    "observability",
    "infra",
    "deploy"
  ],
  "conditional": [
    ".env.example",
    "apps/vite/.env.example",
    "apps/api/.env.example",
    "apps/api-fastapi/.env.example",
    ".github/workflows/ci.yml",
    ".github/workflows/deploy.yml",
    ".github/workflows/preview.yml",
    "AGENTS.md",
    "README.md",
    "apps/vite/src/routes/index.tsx",
    "SETUP.md",
    "docker-compose.dev.yml",
    "docker-compose.yml",
    "render.yaml",
    "supabase/config.toml"
  ],
  "exclude": [
    ".github/assets",
    ".github/dependabot.yml",
    ".github/workflows/starter.yml",
    "ROADMAP.md",
    "clubedge.template.json",
    "scripts/template-manifest.test.ts"
  ]
}

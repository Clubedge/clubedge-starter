    "infra": {
      "name": "Local infrastructure",
      "default": "docker",
      "options": {
        "docker": {
          "name": "Docker Compose",
          "files": ["docker-compose.dev.yml"],
          "scripts": {
            "dev": "turbo run dev --filter=@clubedge/web",
            "infra:up": "docker compose -f docker-compose.dev.yml up -d --wait",
            "infra:down": "docker compose -f docker-compose.dev.yml down",
            "infra:reset": "docker compose -f docker-compose.dev.yml down --volumes",
            "infra:logs": "docker compose -f docker-compose.dev.yml logs --follow"
          }
        },
        "supabase": {
          "name": "Supabase CLI",
          "files": ["supabase"],
          "scripts": {
            "dev": "turbo run dev --filter=@clubedge/web",
            "infra:up": "npx --yes supabase@2 start",
            "infra:down": "npx --yes supabase@2 stop",
            "infra:reset": "npx --yes supabase@2 stop --no-backup",
            "infra:status": "npx --yes supabase@2 status"
          }
        },
        "local": {
          "name": "No Docker (PGlite and a local folder)",
          "packages": {
            "@clubedge/local-db": "packages/local-db"
          },
          "scripts": {
            "dev": "turbo run dev --filter=@clubedge/web --filter=@clubedge/local-db",
            "infra:up": "pnpm --filter @clubedge/local-db dev",
            "infra:reset": "node -e \"require('node:fs').rmSync('.data', { recursive: true, force: true })\""
          }
        },
        "neon": {
          "name": "Neon (hosted PostgreSQL, nothing to install)",
          "files": [".github/workflows/preview.yml"],
          "scripts": {
            "dev": "turbo run dev --filter=@clubedge/web"
          }
        },
        "none": {
          "name": "None (bring your own services)",
          "scripts": {
            "dev": "turbo run dev --filter=@clubedge/web"
          }
        }
      }
    },
    "deploy": {
      "name": "Deployment",
      "default": "docker",
      "options": {
        "docker": {
          "name": "Docker image, on any container host"
        },
        "fly": {
          "name": "Fly.io",
          "files": ["fly.toml"]
        },
        "railway": {
          "name": "Railway",
          "files": [".railway/railway.ts"]
        },
        "render": {
          "name": "Render",
          "files": ["render.yaml"]
        },
        "vercel": {
          "name": "Vercel",
          "files": ["apps/start/vercel.json", "apps/web/vercel.json"]
        },
        "netlify": {
          "name": "Netlify",
          "files": ["apps/start/netlify.toml", "apps/web/netlify.toml"]
        }
      }
    }
  },
  "conditional": [
    ".env.example",
    ".github/workflows/ci.yml",
    ".github/workflows/deploy.yml",
    ".github/workflows/preview.yml",
    "AGENTS.md",
    "README.md",
    "SETUP.md",
    "apps/start/.env.example",
    "apps/start/scripts/check-services.ts",
    "apps/start/src/components/route-error.tsx",
    "apps/start/src/env/auth.ts",
    "apps/start/src/env/production.ts",
    "apps/start/src/jobs/index.ts",
    "apps/start/src/routes/__root.tsx",
    "apps/start/src/routes/dashboard.tsx",

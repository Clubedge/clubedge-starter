            "apps/web/src/app/dashboard/_components/jobs-card.tsx",
            "apps/web/src/instrumentation.ts",
            "apps/web/src/jobs",
            "apps/web/src/server/jobs.ts",
            "e2e/jobs.spec.ts"
          ],
          "replace": {
            "apps/web/src/server/jobs.ts": "apps/web/src/server/variants/jobs.inngest.ts",
            "apps/start/src/server/jobs.ts": "apps/start/src/server/variants/jobs.inngest.ts"
          },
          "scripts": {
            "jobs:dev": "npx --yes --ignore-scripts=false inngest-cli@latest dev"
          }
        },
        "none": {
          "name": "None"
        }
      }
    },
    "observability": {
      "name": "Observability",
      "default": "none",
      "options": {
        "otel": {
          "name": "OpenTelemetry (OTLP to any collector)",
          "packages": {
            "@clubedge/observability": "packages/observability",
            "@clubedge/observability-otel": "packages/observability-otel"
          },
          "files": [
            "apps/start/src/components/error-reporting.tsx",
            "apps/start/src/nitro/plugins/observability.ts",
            "apps/start/src/routes/api/client-errors.ts",
            "apps/start/src/server/observability.test.ts",
            "apps/start/src/server/observability.ts",
            "apps/web/src/app/api/client-errors",
            "apps/web/src/components/error-reporting.tsx",
            "apps/web/src/instrumentation.ts",
            "apps/web/src/server/observability.ts",
            "e2e/observability.spec.ts",
            "e2e/telemetry-fake.ts"
          ]
        },
        "sentry": {
          "name": "Sentry",
          "packages": {
            "@clubedge/observability": "packages/observability",
            "@clubedge/observability-sentry": "packages/observability-sentry"
          },
          "files": [
            "apps/start/src/components/error-reporting.tsx",
            "apps/start/src/nitro/plugins/observability.ts",
            "apps/start/src/routes/api/client-errors.ts",
            "apps/start/src/server/observability.test.ts",
            "apps/start/src/server/observability.ts",
            "apps/web/src/app/api/client-errors",
            "apps/web/src/components/error-reporting.tsx",
            "apps/web/src/instrumentation.ts",
            "apps/web/src/server/observability.ts",
            "e2e/observability.spec.ts",

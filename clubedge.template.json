          ],
          "replace": {
            "apps/start/src/components/error-reporting.tsx": "apps/start/src/components/variants/error-reporting.sentry.tsx",
            "apps/start/src/server/observability.ts": "apps/start/src/server/variants/observability.sentry.ts",
            "apps/web/src/components/error-reporting.tsx": "apps/web/src/components/variants/error-reporting.sentry.tsx",
            "apps/web/src/server/observability.ts": "apps/web/src/server/variants/observability.sentry.ts"
          }
        },
        "none": {
          "name": "None"
        }
      }

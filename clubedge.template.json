{
  "schemaVersion": 3,
  "name": "clubedge-starter",
  "packageManager": "pnpm",
  "app": "apps/web",
  "appPackage": "@clubedge/web",
  "siteConfig": "apps/web/src/config/site.json",
  "env": {
    "example": ".env.example",
    "target": "apps/web/.env.local"
  },
  "dockerImage": "clubedge-starter",
  "defaultFramework": "next",
  "frameworks": {
    "next": {
      "name": "Next.js",
      "app": "apps/web",
      "envExample": ".env.example",
      "dockerfile": "Dockerfile"
    },
    "tanstack-start": {
      "name": "TanStack Start",
      "app": "apps/start",
      "envExample": "apps/start/.env.example",
      "dockerfile": "apps/start/Dockerfile"
    }
  },
  "modules": {
    "auth": {
      "name": "Authentication",
      "default": "supabase",
      "options": {
        "supabase": {
          "name": "Supabase Auth",
          "packages": {
            "@clubedge/auth": "packages/auth",
            "@clubedge/auth-supabase": "packages/auth-supabase"
          },
          "files": [
            "apps/start/src/components/auth",
            "apps/start/src/env/auth.test.ts",
            "apps/start/src/env/auth.ts",
            "apps/start/src/lib/login-url.test.ts",
            "apps/start/src/lib/login-url.ts",
            "apps/start/src/routes/auth",
            "apps/start/src/routes/forgot-password.tsx",
            "apps/start/src/routes/login.tsx",
            "apps/start/src/routes/reset-password.tsx",
            "apps/start/src/server/auth-forms.test.ts",
            "apps/start/src/server/auth-forms.ts",
            "apps/start/src/server/cookies.test.ts",
            "apps/start/src/server/cookies.ts",
            "apps/start/src/server/users.ts",
            "apps/web/src/app/actions",
            "apps/web/src/app/auth",
            "apps/web/src/app/forgot-password",
            "apps/web/src/app/login",
            "apps/web/src/app/reset-password",
            "apps/web/src/env/auth.ts",
            "apps/web/src/lib/login-url.test.ts",
            "apps/web/src/lib/login-url.ts",
            "apps/web/src/proxy.ts",
            "apps/web/src/server/cookies.ts",
            "apps/web/src/server/users.ts",
            "e2e/auth-flow.spec.ts",
            "e2e/auth.spec.ts",
            "e2e/inbox.ts",
            "e2e/password-reset.spec.ts"
          ]
        },
        "better-auth": {
          "name": "Better Auth",
          "packages": {
            "@clubedge/auth": "packages/auth",
            "@clubedge/auth-better-auth": "packages/auth-better-auth"
          },
          "files": [
            "apps/start/src/components/auth",
            "apps/start/src/env/auth.ts",
            "apps/start/src/lib/login-url.test.ts",
            "apps/start/src/lib/login-url.ts",
            "apps/start/src/routes/auth",
            "apps/start/src/routes/forgot-password.tsx",
            "apps/start/src/routes/login.tsx",
            "apps/start/src/routes/reset-password.tsx",
            "apps/start/src/server/auth-email.ts",
            "apps/start/src/server/auth-forms.test.ts",
            "apps/start/src/server/auth-forms.ts",
            "apps/start/src/server/cookies.test.ts",
            "apps/start/src/server/cookies.ts",
            "apps/start/src/server/users.ts",
            "apps/web/src/app/actions",
            "apps/web/src/app/auth",
            "apps/web/src/app/forgot-password",
            "apps/web/src/app/login",
            "apps/web/src/app/reset-password",
            "apps/web/src/env/auth.ts",
            "apps/web/src/lib/login-url.test.ts",
            "apps/web/src/lib/login-url.ts",
            "apps/web/src/server/auth-email.ts",
            "apps/web/src/server/cookies.ts",
            "apps/web/src/server/users.ts",
            "e2e/auth-flow.spec.ts",
            "e2e/auth.spec.ts",
            "e2e/email-verification.spec.ts",
            "e2e/inbox.ts",
            "e2e/password-reset.spec.ts"
          ],
          "replace": {
            "apps/web/src/server/auth.ts": "apps/web/src/server/variants/auth.better-auth.ts",
            "apps/web/src/proxy.ts": "apps/web/src/variants/proxy.better-auth.ts",
            "apps/start/src/server/auth.ts": "apps/start/src/server/variants/auth.better-auth.ts"
          }
        },
        "none": {
          "name": "None",
          "replace": {
            "apps/web/src/server/auth.ts": "apps/web/src/server/variants/auth.none.ts",
            "apps/start/src/server/auth.ts": "apps/start/src/server/variants/auth.none.ts",
            "apps/start/src/server/auth.functions.ts": "apps/start/src/server/variants/auth.functions.none.ts",
            "apps/web/src/app/dashboard/_components/account-button.tsx": "apps/web/src/app/dashboard/_components/variants/account-button.none.tsx",
            "apps/start/src/components/dashboard/account-button.tsx": "apps/start/src/components/dashboard/variants/account-button.none.tsx"
          }
        }
      }
    },
    "storage": {
      "name": "File storage",
      "default": "s3",
      "options": {
        "s3": {
          "name": "S3-compatible",
          "packages": {
            "@clubedge/storage": "packages/storage",
            "@clubedge/storage-s3": "packages/storage-s3"
          },
          "files": ["apps/web/src/server/storage.ts", "apps/start/src/server/storage.ts"]
        },
        "supabase": {
          "name": "Supabase Storage",
          "packages": {
            "@clubedge/storage": "packages/storage",
            "@clubedge/storage-supabase": "packages/storage-supabase"
          },
          "files": ["apps/web/src/server/storage.ts", "apps/start/src/server/storage.ts"],
          "replace": {
            "apps/web/src/server/storage.ts": "apps/web/src/server/variants/storage.supabase.ts",
            "apps/start/src/server/storage.ts": "apps/start/src/server/variants/storage.supabase.ts"
          },
          "requires": {
            "auth": "supabase"
          }
        },
        "none": {
          "name": "None"
        }
      }
    },
    "cache": {
      "name": "Cache and rate limits",
      "default": "redis",
      "options": {
        "redis": {
          "name": "Redis, or memory without REDIS_URL",
          "packages": {
            "@clubedge/cache-redis": "packages/cache-redis"
          },
          "files": ["apps/start/src/server/cache.test.ts"]
        },
        "memory": {
          "name": "Memory only",
          "replace": {
            "apps/web/src/server/cache.ts": "apps/web/src/server/variants/cache.memory.ts",
            "apps/start/src/server/cache.ts": "apps/start/src/server/variants/cache.memory.ts"
          }
        }
      }
    },
    "email": {
      "name": "Email",
      "default": "smtp",
      "options": {
        "smtp": {
          "name": "SMTP (any provider, or a local inbox)",
          "packages": {
            "@clubedge/email": "packages/email",
            "@clubedge/email-smtp": "packages/email-smtp"
          },
          "files": ["apps/start/src/server/email.ts", "apps/web/src/server/email.ts"]
        },
        "resend": {
          "name": "Resend",
          "packages": {
            "@clubedge/email": "packages/email",
            "@clubedge/email-resend": "packages/email-resend"
          },
          "files": ["apps/start/src/server/email.ts", "apps/web/src/server/email.ts"],
          "replace": {
            "apps/start/src/server/email.ts": "apps/start/src/server/variants/email.resend.ts",
            "apps/web/src/server/email.ts": "apps/web/src/server/variants/email.resend.ts"
          }
        },
        "none": {
          "name": "None"
        }
      }
    },
    "infra": {
      "name": "Local infrastructure",
      "default": "docker",
      "options": {
        "docker": {
          "name": "Docker Compose",
          "files": ["docker-compose.dev.yml"],
          "scripts": {
            "dev": "turbo run dev --filter=@clubedge/web",
            "infra:up": "docker compose -f docker-compose.dev.yml up -d --wait",
            "infra:down": "docker compose -f docker-compose.dev.yml down",
            "infra:reset": "docker compose -f docker-compose.dev.yml down --volumes",
            "infra:logs": "docker compose -f docker-compose.dev.yml logs --follow"
          }
        },
        "supabase": {
          "name": "Supabase CLI",
          "files": ["supabase"],
          "scripts": {
            "dev": "turbo run dev --filter=@clubedge/web",
            "infra:up": "npx --yes supabase@2 start",
            "infra:down": "npx --yes supabase@2 stop",
            "infra:reset": "npx --yes supabase@2 stop --no-backup",
            "infra:status": "npx --yes supabase@2 status"
          }
        },
        "local": {
          "name": "No Docker (PGlite and a local folder)",
          "packages": {
            "@clubedge/local-db": "packages/local-db"
          },
          "scripts": {
            "dev": "turbo run dev --filter=@clubedge/web --filter=@clubedge/local-db",
            "infra:up": "pnpm --filter @clubedge/local-db dev",
            "infra:reset": "node -e \"require('node:fs').rmSync('.data', { recursive: true, force: true })\""
          }
        },
        "none": {
          "name": "None (bring your own services)",
          "scripts": {
            "dev": "turbo run dev --filter=@clubedge/web"
          }
        }
      }
    },
    "deploy": {
      "name": "Deployment",
      "default": "docker",
      "options": {
        "docker": {
          "name": "Docker image, on any container host"
        },
        "fly": {
          "name": "Fly.io",
          "files": ["fly.toml"]
        },
        "railway": {
          "name": "Railway",
          "files": ["railway.json"]
        },
        "render": {
          "name": "Render",
          "files": ["render.yaml"]
        },
        "vercel": {
          "name": "Vercel",
          "files": ["apps/start/vercel.json", "apps/web/vercel.json"]
        },
        "netlify": {
          "name": "Netlify",
          "files": ["apps/start/netlify.toml", "apps/web/netlify.toml"]
        }
      }
    }
  },
  "conditional": [
    ".env.example",
    ".github/workflows/ci.yml",
    "AGENTS.md",
    "README.md",
    "SETUP.md",
    "apps/start/.env.example",
    "apps/start/scripts/check-services.ts",
    "apps/start/src/env/auth.ts",
    "apps/start/src/routes/dashboard.tsx",
    "apps/start/src/routes/index.tsx",
    "apps/start/src/server/auth-email.ts",
    "apps/start/src/server/storage.ts",
    "apps/web/scripts/check-services.ts",
    "apps/web/src/app/dashboard/page.tsx",
    "apps/web/src/app/page.tsx",
    "apps/web/src/env/auth.ts",
    "apps/web/src/server/auth-email.ts",
    "apps/web/src/server/storage.ts",
    "docker-compose.dev.yml",
    "render.yaml",
    "supabase/config.toml"
  ],
  "exclude": [
    ".github/workflows/starter.yml",
    "ROADMAP.md",
    "clubedge.template.json",
    "scripts/template-manifest.test.ts"
  ]
}

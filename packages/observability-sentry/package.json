{
  "name": "@clubedge/observability-sentry",
  "version": "0.30.0",
  "description": "Sentry provider for @clubedge/observability: server and browser errors, traces, and source map uploads.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./sourcemaps": "./src/sourcemaps.cjs",
    "./vite": "./src/vite.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clubedge/observability": "workspace:*",
    "@sentry/browser": "^11.6.0",
    "@sentry/cli": "^3.8.0",
    "@sentry/node": "^11.6.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}

{
  "name": "@clubedge/contract",
  "version": "0.30.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "clubedge-contract-check": "./scripts/check-api.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./conformance": "./src/conformance.ts",
    "./openapi.yaml": "./openapi.yaml"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o src/schema.ts && prettier --write src/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.2"
  }
}

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase PostgreSQL: use the transaction pooler with prepare disabled (configured in packages/db). # clubedge:only infra=none
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres # clubedge:only infra=none
# Local Supabase database, started by pnpm infra:up. # clubedge:only infra=supabase
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres # clubedge:only infra=supabase
# Local PostgreSQL from docker-compose.dev.yml, started by pnpm infra:up. # clubedge:only infra=docker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app # clubedge:only infra=docker
# Local PostgreSQL (PGlite) that pnpm dev starts; no Docker needed. # clubedge:only infra=local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres # clubedge:only infra=local
# Neon PostgreSQL. create-clubedge-app filled in a free database that expires after 72 hours # clubedge:only infra=neon
# unless you claim it (pnpm clubedge neon claim); or paste your own project's URLs from the Neon # clubedge:only infra=neon
# console. DATABASE_URL is the pooled connection, its host ends in -pooler. # clubedge:only infra=neon
DATABASE_URL= # clubedge:only infra=neon
# Optional: the direct (unpooled) URL, for migrations and the background jobs worker, which need a # clubedge:only infra=none|neon
# whole session; a transaction pooler can break them. Neon: the same URL without -pooler. # clubedge:only infra=none|neon
DATABASE_URL_DIRECT= # clubedge:only infra=none|neon

# Where rate limits find each client's address (SETUP.md, "Client addresses"). Next.js gives the
# app no connection address, so without a setting it reads the last X-Forwarded-For entry, the
# one the proxy nearest the app added. Set one for your host: CLIENT_IP_HEADER, a header the host
# sets to the client's address (such as x-real-ip), or TRUSTED_PROXY_HOPS, the number of reverse
# proxies you run in front that append to X-Forwarded-For.
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=

# clubedge:if auth=supabase
# Supabase Auth (publishable key only; never put a service role key in the browser)
NEXT_PUBLIC_SUPABASE_URL= # clubedge:only infra!=supabase
# Local Supabase Auth. pnpm infra:status prints the publishable key to copy below. # clubedge:only infra=supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 # clubedge:only infra=supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional, server-side only: lets users delete their account from the settings page.
SUPABASE_SECRET_KEY=
# clubedge:end

# clubedge:if auth=better-auth
# Better Auth keeps users and sessions in DATABASE_URL (run pnpm db:migrate first).
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# true refuses sign-in until the email address is confirmed through the emailed link. # clubedge:only email!=none
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION=false # clubedge:only email!=none
# clubedge:end

# clubedge:if auth=firebase
# Firebase Authentication. In development, pnpm auth:dev starts the Auth Emulator, which these
# values point at. In production, set your project's id and Web API key (Project settings,
# General) and a service account (Project settings, Service accounts), and remove
# FIREBASE_AUTH_EMULATOR_HOST.
FIREBASE_PROJECT_ID=demo-clubedge
FIREBASE_API_KEY=demo-api-key
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# clubedge:end

# clubedge:if auth=appwrite
# Appwrite (https://appwrite.io), on Appwrite Cloud or your own server. Create a project, add a
# Web platform for this app's hostname (localhost in development), and an API key with the
# sessions.write and users.write scopes. Appwrite sends its own emails (its SMTP settings).
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# clubedge:end

# clubedge:if cache=redis
# Optional cache and rate limits (Redis protocol; rediss:// enables TLS). Without it, both use
# process memory. Upstash example: rediss://default:YOUR_PASSWORD@your-database.upstash.io:6379
REDIS_URL= # clubedge:only infra!=docker
REDIS_URL=redis://localhost:6379 # clubedge:only infra=docker
# clubedge:end

# clubedge:if email=smtp
# Email over SMTP: any provider's SMTP endpoint (smtps:// for TLS). Without it, development
# prints emails to the server log and production refuses to send.
SMTP_URL= # clubedge:only infra!=docker|supabase
# Mailpit from docker-compose.dev.yml; read the emails at http://localhost:8025. # clubedge:only infra=docker
SMTP_URL=smtp://localhost:1025 # clubedge:only infra=docker
# The local Supabase inbox; read the emails at http://127.0.0.1:54324. # clubedge:only infra=supabase
SMTP_URL=smtp://127.0.0.1:54325 # clubedge:only infra=supabase
EMAIL_FROM=App <no-reply@example.com>
# clubedge:end

# clubedge:if email=resend
# Resend (https://resend.com). EMAIL_FROM must use a domain verified in Resend. Without the
# key, development prints emails to the server log and production refuses to send.
RESEND_API_KEY=
EMAIL_FROM=App <no-reply@example.com>
# clubedge:end

# clubedge:if payments=stripe
# Stripe (https://dashboard.stripe.com/apikeys): use test-mode keys during development. The
# webhook secret comes from `stripe listen` locally, or from the endpoint's settings in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Stripe price for each plan in src/config/plans.ts (STRIPE_PRICE_<PLAN>).
STRIPE_PRICE_PRO=
# clubedge:end

# clubedge:if jobs=pg-boss
# Background jobs are stored in DATABASE_URL and run by a worker inside the app server. Set
# JOBS_WORKER=off where no server keeps running (it is off by default on Vercel and Netlify);
# a scheduler then calls /api/jobs/run with CRON_SECRET (16 or more characters) instead.
JOBS_WORKER=
CRON_SECRET=
# clubedge:end

# clubedge:if jobs=bullmq
# Background jobs are stored in Redis (REDIS_URL above) through BullMQ and run by a worker inside
# the app server. Set JOBS_WORKER=off where no server keeps running (it is off by default on
# Vercel and Netlify); a scheduler then calls /api/jobs/run with CRON_SECRET (16 or more
# characters) instead.
JOBS_WORKER=
CRON_SECRET=
# clubedge:end

# clubedge:if jobs=inngest
# Background jobs run by Inngest (https://www.inngest.com), which calls this app's /api/inngest.
# In development, start its Dev Server with pnpm jobs:dev (http://localhost:8288); INNGEST_DEV=1
# points the app at it. In production, remove INNGEST_DEV and set the keys of your Inngest app.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# clubedge:end

# clubedge:if observability=otel
# OpenTelemetry: where traces and error logs go over OTLP/HTTP, such as a collector, Grafana
# Cloud, or Honeycomb. Empty sends nothing. Headers are key=value pairs separated by commas.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=
# clubedge:end

# clubedge:if observability=sentry
# Sentry (https://sentry.io): the DSN from the project's Client Keys settings. Empty sends nothing.
# The traces sample rate is the share of requests traced, from 0 to 1 (default 0.1).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
# Build time only: with an auth token, the build uploads browser source maps to this project.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# clubedge:end

# clubedge:if storage=s3
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO)
STORAGE_BUCKET= # clubedge:only infra!=docker
STORAGE_REGION=auto # clubedge:only infra!=docker
STORAGE_ENDPOINT= # clubedge:only infra!=docker
STORAGE_ACCESS_KEY_ID= # clubedge:only infra!=docker
STORAGE_SECRET_ACCESS_KEY= # clubedge:only infra!=docker
# Local S3-compatible storage from docker-compose.dev.yml; it accepts any credentials. # clubedge:only infra=docker
STORAGE_BUCKET=app # clubedge:only infra=docker
STORAGE_REGION=us-east-1 # clubedge:only infra=docker
STORAGE_ENDPOINT=http://localhost:9090 # clubedge:only infra=docker
STORAGE_ACCESS_KEY_ID=local # clubedge:only infra=docker
STORAGE_SECRET_ACCESS_KEY=local-secret # clubedge:only infra=docker
STORAGE_PUBLIC_URL=
# Without an S3 service, files are stored in this folder (relative to the app). # clubedge:only infra=local
STORAGE_DIRECTORY=../../.data/storage # clubedge:only infra=local
# clubedge:end

# clubedge:if storage=supabase
# Supabase Storage bucket, accessed with the signed-in user's Supabase session
SUPABASE_STORAGE_BUCKET= # clubedge:only infra!=supabase
SUPABASE_STORAGE_BUCKET=app # clubedge:only infra=supabase
# clubedge:end

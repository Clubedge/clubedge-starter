NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase PostgreSQL: use the transaction pooler with prepare disabled (configured in src/db).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase Auth (publishable key only; never put a service role key in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional cache and rate limits (Redis protocol; rediss:// enables TLS)
# Upstash example: rediss://default:YOUR_PASSWORD@your-database.upstash.io:6379
REDIS_URL=

# S3-compatible storage (AWS S3, Cloudflare R2, MinIO)
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

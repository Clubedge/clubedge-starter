# clubedge:if framework!=none
# Where the app sends its requests: your website, whose server forwards /api to the API and
# answers sign-in at /api/auth. Built into the app, so set the https address before a release
# build. Blank in development, the app uses this computer's dev server (pnpm dev): at
# http://10.0.2.2:3000 from the Android emulator, http://localhost:3000 from the iOS simulator.
# On a phone, set it to http://<this computer's address>:3000.
EXPO_PUBLIC_API_URL=
# clubedge:end
# clubedge:if framework=none
# Where the app sends its requests: your API, which also answers sign-in at /api/auth. Built into
# the app, so set the https address before a release build. Blank in development, the app uses
# the API on this computer (pnpm dev), at the port below: at http://10.0.2.2:3001 from the Android
# emulator, http://localhost:3001 from the iOS simulator. On a phone, set it to
# http://<this computer's address>:3001.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_DEV_SERVER_PORT=3001
# clubedge:end

# clubedge:if push!=none
# Firebase's Android settings, which FCM needs to deliver push notifications: the path to your
# google-services.json, such as ./google-services.json (SETUP.md, "Push notifications"). EAS
# builds take the file from an EAS file variable of the same name.
GOOGLE_SERVICES_JSON=
# clubedge:end

# clubedge:if auth=supabase
# Supabase Auth's public settings, the same as the website's. No service role key belongs here. # clubedge:only framework!=none
# Supabase Auth's public settings, the same as the API's. No service role key belongs here. # clubedge:only framework=none
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# clubedge:end

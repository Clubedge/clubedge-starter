# The API's address. The dev server (pnpm dev) forwards /api to it, and so does the Node server
# that pnpm start and the production image run, which reads it at runtime.
API_URL=http://127.0.0.1:3001

# Public API URL for direct cross-origin API calls. Better Auth requires the same-origin frontend
# proxy (blank here), so the browser's HttpOnly session cookie reaches the API securely.
VITE_API_URL=

# Supabase Auth public settings. No service role key belongs in this file.
# clubedge:if auth=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# clubedge:end

# Firebase Authentication public settings. Never put a service account key in the frontend.
# clubedge:if auth=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# clubedge:end

# Appwrite public project settings. The API key belongs only on the API service.
# clubedge:if auth=appwrite
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
# clubedge:end

# Better Auth uses a same-origin HttpOnly session cookie by default.
# clubedge:if auth=better-auth
# The same database as the API's DATABASE_URL.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres # clubedge:only infra=none
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres # clubedge:only infra=supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app # clubedge:only infra=docker
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres # clubedge:only infra=local
DATABASE_URL= # clubedge:only infra=neon
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Sign-in waits for the emailed confirmation link when true.
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION=false
# clubedge:end

# clubedge:if auth=better-auth && email=smtp
# Better Auth's verification and password reset emails, over SMTP: any provider's SMTP
# endpoint (smtps:// for TLS). Without it, development prints emails to the server log and
# production refuses to send.
SMTP_URL= # clubedge:only infra!=docker|supabase
# Mailpit from docker-compose.dev.yml; read the emails at http://localhost:8025. # clubedge:only infra=docker
SMTP_URL=smtp://localhost:1025 # clubedge:only infra=docker
# The local Supabase inbox; read the emails at http://127.0.0.1:54324. # clubedge:only infra=supabase
SMTP_URL=smtp://127.0.0.1:54325 # clubedge:only infra=supabase
EMAIL_FROM=App <no-reply@example.com>
# clubedge:end
# clubedge:if auth=better-auth && email=resend
# Better Auth's verification and password reset emails, through Resend (https://resend.com).
# EMAIL_FROM must use a domain verified in Resend. Without the key, development prints emails
# to the server log and production refuses to send.
RESEND_API_KEY=
EMAIL_FROM=App <no-reply@example.com>
# clubedge:end
# clubedge:if auth=better-auth && email=none
# Better Auth's verification and password reset emails go through Resend when both are set;
# otherwise verification and password reset are off.
RESEND_API_KEY=
EMAIL_FROM=
# clubedge:end

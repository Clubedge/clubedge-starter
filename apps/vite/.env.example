# The API's address. The dev server (pnpm dev) and vite preview forward /api to it, and so does
# the production image's Node server, which reads it at runtime.
API_URL=http://127.0.0.1:3001

# Public API URL for deployments where /api is not proxied by the frontend host. Leave blank for
# the local dev proxy or the production server's same-origin /api proxy.
VITE_API_URL=

# Supabase Auth public settings. No service role key belongs in this file.
# clubedge:if auth=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# clubedge:end

# Firebase Authentication public settings. Never put a service account key in the frontend.
# clubedge:if auth=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# clubedge:end

# Appwrite public project settings. The API key belongs only on the API service.
# clubedge:if auth=appwrite
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
# clubedge:end

# Better Auth uses a same-origin HttpOnly session cookie by default.
# clubedge:if auth=better-auth
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
VITE_BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION=false
# clubedge:end

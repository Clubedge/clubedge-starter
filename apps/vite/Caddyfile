# Serves the built app in the production image and forwards /api to the API, so the browser
# calls the API on its own origin and cookies stay first-party. Set API_URL at runtime.
:{$PORT:3000} {
	encode zstd gzip

	handle /api/* {
		# Send the API's own host name, which hosting platforms route HTTPS traffic by.
		reverse_proxy {$API_URL} {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		root * /srv
		# Hashed assets never change; everything else is revalidated.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Client-side routes such as /dashboard have no file: serve the app shell instead.
		try_files {path} /index.html
		file_server
	}
}

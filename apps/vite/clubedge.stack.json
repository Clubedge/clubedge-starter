{
  "id": "vite",
  "name": "React + Vite",
  "role": "frontend",
  "envExample": ".env.example",
  "dockerfile": "Dockerfile",
  "conditional": [
    "auth.server.mjs",
    "server.mjs",
    "src/components/billing/billing-card.tsx",
    "src/components/dashboard/variants/account-button.supabase.tsx",
    "src/components/route-error.tsx",
    "src/lib/api.ts",
    "src/main.tsx",
    "src/routes/dashboard.tsx",
    "src/routes/settings.tsx",
    "src/styles.css",
    "src/variants/api.better-auth.ts",
    "src/variants/api.supabase.ts",
    "src/variants/auth.better-auth.ts",
    "src/variants/auth.firebase.ts",
    "src/variants/auth.supabase.ts",
    "vite.config.ts"
  ],
  "deployment": {
    "id": "web",
    "port": 3000,
    "healthPath": "/",
    "platforms": ["docker", "railway"]
  },
  "modules": {
    "auth": {
      "none": {},
      "supabase": {
        "files": [
          "src/lib/auth-client.ts",
          "src/lib/auth.ts",
          "src/variants/api.supabase.ts",
          "src/routes/login.tsx",
          "src/routes/forgot-password.tsx",
          "src/routes/reset-password.tsx",
          "src/routes/settings.tsx",
          "src/variants/router.supabase.tsx",
          "src/components/dashboard/variants/account-button.supabase.tsx",
          "src/variants/auth-enabled.supabase.ts"
        ],
        "replace": {
          "src/lib/auth.ts": "src/variants/auth.supabase.ts",
          "src/router.tsx": "src/variants/router.supabase.tsx",
          "src/lib/api.ts": "src/variants/api.supabase.ts",
          "src/lib/auth-enabled.ts": "src/variants/auth-enabled.supabase.ts",
          "src/components/dashboard/account-button.tsx": "src/components/dashboard/variants/account-button.supabase.tsx"
        }
      },
      "firebase": {
        "files": [
          "src/lib/auth-client.ts",
          "src/routes/login.tsx",
          "src/routes/forgot-password.tsx",
          "src/routes/reset-password.tsx",
          "src/routes/settings.tsx",
          "src/variants/auth.firebase.ts",
          "src/variants/router.supabase.tsx",
          "src/variants/api.supabase.ts",
          "src/variants/auth-enabled.supabase.ts",
          "src/components/dashboard/variants/account-button.supabase.tsx"
        ],
        "replace": {
          "src/lib/auth.ts": "src/variants/auth.firebase.ts",
          "src/router.tsx": "src/variants/router.supabase.tsx",
          "src/lib/api.ts": "src/variants/api.supabase.ts",
          "src/lib/auth-enabled.ts": "src/variants/auth-enabled.supabase.ts",
          "src/components/dashboard/account-button.tsx": "src/components/dashboard/variants/account-button.supabase.tsx"
        }
      },
      "appwrite": {
        "files": [
          "src/lib/auth-client.ts",
          "src/routes/login.tsx",
          "src/routes/forgot-password.tsx",
          "src/routes/reset-password.tsx",
          "src/routes/settings.tsx",
          "src/variants/auth.appwrite.ts",
          "src/variants/router.supabase.tsx",
          "src/variants/api.supabase.ts",
          "src/variants/auth-enabled.supabase.ts",
          "src/components/dashboard/variants/account-button.supabase.tsx"
        ],
        "replace": {
          "src/lib/auth.ts": "src/variants/auth.appwrite.ts",
          "src/router.tsx": "src/variants/router.supabase.tsx",
          "src/lib/api.ts": "src/variants/api.supabase.ts",
          "src/lib/auth-enabled.ts": "src/variants/auth-enabled.supabase.ts",
          "src/components/dashboard/account-button.tsx": "src/components/dashboard/variants/account-button.supabase.tsx"
        }
      },
      "better-auth": {
        "files": [
          "auth.server.mjs",
          "src/lib/auth-client.ts",
          "src/variants/api.better-auth.ts",
          "src/routes/login.tsx",
          "src/routes/forgot-password.tsx",
          "src/routes/reset-password.tsx",
          "src/routes/settings.tsx",
          "src/variants/auth.better-auth.ts",
          "src/variants/router.supabase.tsx",
          "src/variants/api.supabase.ts",
          "src/variants/auth-enabled.supabase.ts",
          "src/components/dashboard/variants/account-button.supabase.tsx"
        ],
        "replace": {
          "src/lib/auth.ts": "src/variants/auth.better-auth.ts",
          "src/router.tsx": "src/variants/router.supabase.tsx",
          "src/lib/api.ts": "src/variants/api.better-auth.ts",
          "src/lib/auth-enabled.ts": "src/variants/auth-enabled.supabase.ts",
          "src/components/dashboard/account-button.tsx": "src/components/dashboard/variants/account-button.supabase.tsx"
        }
      }
    },
    "email": {
      "smtp": {},
      "resend": {},
      "none": {}
    },
    "jobs": {
      "pg-boss|bullmq|inngest": {
        "files": ["src/components/jobs"]
      },
      "none": {}
    },
    "payments": {
      "stripe": {
        "files": ["src/components/billing"]
      },
      "none": {}
    },
    "observability": {
      "otel|sentry": {
        "files": ["src/components/error-reporting.tsx"]
      },
      "sentry": {
        "replace": {
          "src/components/error-reporting.tsx": "src/components/variants/error-reporting.sentry.tsx"
        }
      },
      "none": {}
    },
    "deploy": {
      "docker": {},
      "railway": {}
    },
    "push": {
      "none|expo|native": {}
    }
  }
}

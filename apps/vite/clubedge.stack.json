{
  "id": "vite",
  "name": "React + Vite",
  "role": "frontend",
  "envExample": ".env.example",
  "dockerfile": "Dockerfile",
  "deployment": {
    "id": "web",
    "port": 3000,
    "healthPath": "/",
    "platforms": ["docker", "railway"]
  },
  "modules": {
    "auth": {
      "none": {},
      "supabase": {
        "files": [
          "src/lib/auth.ts",
          "src/variants/api.supabase.ts",
          "src/routes/login.tsx",
          "src/routes/forgot-password.tsx",
          "src/routes/reset-password.tsx",
          "src/variants/router.supabase.tsx",
          "src/components/dashboard/variants/account-button.supabase.tsx",
          "src/variants/auth-enabled.supabase.ts"
        ],
        "replace": {
          "src/router.tsx": "src/variants/router.supabase.tsx",
          "src/lib/api.ts": "src/variants/api.supabase.ts",
          "src/lib/auth-enabled.ts": "src/variants/auth-enabled.supabase.ts",
          "src/components/dashboard/account-button.tsx": "src/components/dashboard/variants/account-button.supabase.tsx"
        }
      }
    },
    "deploy": {
      "docker": {},
      "railway": {}
    }
  }
}

{
  "id": "hono",
  "name": "Hono (TypeScript)",
  "role": "api",
  "envExample": ".env.example",
  "dockerfile": "Dockerfile",
  "conditional": ["scripts/check-services.ts", "src/env/production.ts", "src/server/storage.ts"],
  "deployment": {
    "id": "api",
    "port": 3001,
    "healthPath": "/api/health",
    "platforms": ["docker", "railway"]
  },
  "modules": {
    "auth": {
      "none": {},
      "supabase": {
        "replace": {
          "src/server/auth.ts": "src/server/variants/auth.supabase.ts"
        }
      },
      "firebase": {
        "files": ["src/server/variants/auth.firebase.ts"],
        "replace": {
          "src/server/auth.ts": "src/server/variants/auth.firebase.ts"
        }
      },
      "appwrite": {
        "files": ["src/server/variants/auth.appwrite.ts"],
        "replace": {
          "src/server/auth.ts": "src/server/variants/auth.appwrite.ts"
        }
      },
      "better-auth": {
        "files": ["src/server/variants/auth.better-auth.ts"],
        "replace": {
          "src/server/auth.ts": "src/server/variants/auth.better-auth.ts"
        }
      }
    },
    "storage": {
      "s3|supabase": {
        "files": ["src/server/storage.ts"]
      },
      "supabase": {
        "replace": {
          "src/server/storage.ts": "src/server/variants/storage.supabase.ts"
        }
      },
      "none": {}
    },
    "cache": {
      "memory": {}
    },
    "email": {
      "smtp|resend": {
        "files": ["src/server/email.ts"]
      },
      "resend": {
        "replace": {
          "src/server/email.ts": "src/server/variants/email.resend.ts"
        }
      },
      "none": {}
    },
    "payments": {
      "none": {}
    },
    "jobs": {
      "none": {}
    },
    "observability": {
      "none": {}
    },
    "deploy": {
      "docker": {},
      "railway": {}
    }
  }
}

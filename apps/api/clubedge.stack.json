{
  "id": "hono",
  "name": "Hono (TypeScript)",
  "role": "api",
  "envExample": ".env.example",
  "dockerfile": "Dockerfile",
  "conditional": [
    "scripts/check-services.ts",
    "src/app.ts",
    "src/env/production.ts",
    "src/index.ts",
    "src/server/index.ts",
    "src/server/storage.ts"
  ],
  "deployment": {
    "id": "api",
    "port": 3001,
    "healthPath": "/api/health",
    "platforms": ["docker", "railway"]
  },
  "modules": {
    "auth": {
      "none": {},
      "supabase": {
        "replace": {
          "src/server/auth.ts": "src/server/variants/auth.supabase.ts"
        }
      },
      "firebase": {
        "files": ["src/server/variants/auth.firebase.ts"],
        "replace": {
          "src/server/auth.ts": "src/server/variants/auth.firebase.ts"
        }
      },
      "appwrite": {
        "files": ["src/server/variants/auth.appwrite.ts"],
        "replace": {
          "src/server/auth.ts": "src/server/variants/auth.appwrite.ts"
        }
      },
      "better-auth": {
        "files": ["src/server/variants/auth.better-auth.ts"],
        "replace": {
          "src/server/auth.ts": "src/server/variants/auth.better-auth.ts"
        }
      }
    },
    "storage": {
      "s3|supabase": {
        "files": ["src/server/storage.ts"]
      },
      "supabase": {
        "replace": {
          "src/server/storage.ts": "src/server/variants/storage.supabase.ts"
        }
      },
      "none": {}
    },
    "cache": {
      "redis": {
        "files": ["src/server/cache.test.ts"]
      },
      "memory": {
        "replace": {
          "src/server/cache.ts": "src/server/variants/cache.memory.ts"
        }
      }
    },
    "email": {
      "smtp|resend": {
        "files": ["src/server/email.ts"]
      },
      "resend": {
        "replace": {
          "src/server/email.ts": "src/server/variants/email.resend.ts"
        }
      },
      "none": {}
    },
    "payments": {
      "none": {}
    },
    "jobs": {
      "none": {}
    },
    "observability": {
      "otel|sentry": {
        "files": [
          "src/routes/client-errors.test.ts",
          "src/routes/client-errors.ts",
          "src/server/observability.test.ts",
          "src/server/observability.ts",
          "src/tracing.ts"
        ]
      },
      "sentry": {
        "replace": {
          "src/server/observability.ts": "src/server/variants/observability.sentry.ts"
        }
      },
      "none": {}
    },
    "deploy": {
      "docker": {},
      "railway": {}
    }
  }
}

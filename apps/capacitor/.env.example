# The website's public address, such as https://app.example.com. The app's pages load from the
# device: it calls the API through the website, and emailed links open the website.
WEB_URL=

# The app is built with the web app's settings, from apps/web/.env.local; the settings here win.
# Set the deployed website's public values where development uses others.
# clubedge:if auth=firebase
# The Auth Emulator runs on your computer, out of the device's reach.
VITE_FIREBASE_AUTH_EMULATOR_URL=
# clubedge:end
# clubedge:if auth=supabase && infra=supabase
# The local Supabase runs on your computer, out of the device's reach: the app needs your Supabase
# project's URL and publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# clubedge:end

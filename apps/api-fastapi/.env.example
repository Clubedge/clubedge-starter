# The API. The frontend's dev server proxies /api here (its API_URL).
HOST=127.0.0.1
PORT=3001
FRONTEND_URL=http://localhost:3000

# Supabase PostgreSQL: use the transaction pooler. # clubedge:only infra=none
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres # clubedge:only infra=none
# Local Supabase database, started by pnpm infra:up. # clubedge:only infra=supabase
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres # clubedge:only infra=supabase
# Local PostgreSQL from docker-compose.dev.yml, started by pnpm infra:up. # clubedge:only infra=docker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app # clubedge:only infra=docker
# Local PostgreSQL (PGlite) that pnpm dev starts; no Docker needed. # clubedge:only infra=local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres # clubedge:only infra=local
# Neon PostgreSQL. create-clubedge-app filled in a free database that expires after 72 hours # clubedge:only infra=neon
# unless you claim it (pnpm clubedge neon claim). DATABASE_URL is the pooled connection. # clubedge:only infra=neon
DATABASE_URL= # clubedge:only infra=neon
# Optional: the direct (unpooled) URL, for migrations behind a pooler.
DATABASE_URL_DIRECT=

# Supabase Auth. The API validates browser access tokens with Supabase Auth.
# clubedge:if auth=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional: the project's secret key (server-side only), which deleting accounts needs.
SUPABASE_SECRET_KEY=
# clubedge:end

# Firebase Authentication. The Firebase API key is public; no service account is needed here.
# clubedge:if auth=firebase
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# clubedge:end

# Appwrite project settings.
# clubedge:if auth=appwrite
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
# Optional: an API key with the sessions.write and users.write scopes, to delete accounts.
APPWRITE_API_KEY=
# clubedge:end

# Better Auth service origin (the frontend origin when it hosts /api/auth).
# clubedge:if auth=better-auth
BETTER_AUTH_URL=http://localhost:3000
# clubedge:end

# clubedge:if storage=s3
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO)
STORAGE_BUCKET= # clubedge:only infra!=docker
STORAGE_REGION=auto # clubedge:only infra!=docker
STORAGE_ENDPOINT= # clubedge:only infra!=docker
STORAGE_ACCESS_KEY_ID= # clubedge:only infra!=docker
STORAGE_SECRET_ACCESS_KEY= # clubedge:only infra!=docker
# Local S3-compatible storage from docker-compose.dev.yml; it accepts any credentials. # clubedge:only infra=docker
STORAGE_BUCKET=app # clubedge:only infra=docker
STORAGE_REGION=us-east-1 # clubedge:only infra=docker
STORAGE_ENDPOINT=http://localhost:9090 # clubedge:only infra=docker
STORAGE_ACCESS_KEY_ID=local # clubedge:only infra=docker
STORAGE_SECRET_ACCESS_KEY=local-secret # clubedge:only infra=docker
STORAGE_PUBLIC_URL=
# Without an S3 service, files are stored in this folder (relative to the API). # clubedge:only infra=local
STORAGE_DIRECTORY=../../.data/storage # clubedge:only infra=local
# clubedge:end

# clubedge:if storage=supabase
# Supabase Storage bucket, accessed as the user whose access token the request carries
SUPABASE_STORAGE_BUCKET= # clubedge:only infra!=supabase
SUPABASE_STORAGE_BUCKET=app # clubedge:only infra=supabase
# clubedge:end

# clubedge:if email=smtp
# Email over SMTP: any provider's SMTP endpoint (smtps:// for TLS). Without it, development
# prints emails to the server log and production refuses to send.
SMTP_URL= # clubedge:only infra!=docker|supabase
# Mailpit from docker-compose.dev.yml; read the emails at http://localhost:8025. # clubedge:only infra=docker
SMTP_URL=smtp://localhost:1025 # clubedge:only infra=docker
# The local Supabase inbox; read the emails at http://127.0.0.1:54324. # clubedge:only infra=supabase
SMTP_URL=smtp://127.0.0.1:54325 # clubedge:only infra=supabase
EMAIL_FROM=App <no-reply@example.com>
# clubedge:end

# clubedge:if email=resend
# Resend (https://resend.com). EMAIL_FROM must use a domain verified in Resend. Without the
# key, development prints emails to the server log and production refuses to send.
RESEND_API_KEY=
EMAIL_FROM=App <no-reply@example.com>
# clubedge:end

# clubedge:if payments=stripe
# Stripe (https://dashboard.stripe.com/apikeys): use test-mode keys during development. The
# webhook secret comes from `stripe listen` locally, or from the endpoint's settings in production;
# Stripe calls the webhook through the frontend, at FRONTEND_URL/api/webhooks/payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Stripe price for each plan in src/clubedge_api/plans.py (STRIPE_PRICE_<PLAN>).
STRIPE_PRICE_PRO=
# Tests can send Stripe API requests to a stand-in, such as stripe-mock or the fake in
# e2e/stripe-fake.ts: STRIPE_API_BASE=http://127.0.0.1:12111. Leave it unset otherwise.
# clubedge:end

# clubedge:if jobs=bullmq
# Background jobs are stored in Redis (REDIS_URL) through BullMQ and run by a worker inside the
# API. JOBS_WORKER=off turns the worker off; a scheduler then calls /api/jobs/run with CRON_SECRET
# (16 or more characters) instead.
JOBS_WORKER=
CRON_SECRET=
# clubedge:end

# clubedge:if jobs=inngest
# Background jobs run by Inngest (https://www.inngest.com), which calls /api/inngest through the
# frontend (FRONTEND_URL above), so the API stays private. In development, start its Dev Server
# with pnpm jobs:dev (http://localhost:8288); INNGEST_DEV=1 points the API at it. In production,
# remove INNGEST_DEV and set the keys of your Inngest app.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# clubedge:end

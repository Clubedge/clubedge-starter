# The API. The frontend's dev server proxies /api here (its API_URL).
HOST=127.0.0.1
PORT=3001
FRONTEND_URL=http://localhost:3000

# PostgreSQL. `pnpm infra:up` starts one on this URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Optional: the direct (unpooled) URL, for migrations behind a pooler.
DATABASE_URL_DIRECT=

# Supabase Auth. The API validates browser access tokens with Supabase Auth.
# clubedge:if auth=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# clubedge:end

# Firebase Authentication. The Firebase API key is public; no service account is needed here.
# clubedge:if auth=firebase
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# clubedge:end

# Appwrite project settings.
# clubedge:if auth=appwrite
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
# clubedge:end

# Better Auth service origin (the frontend origin when it hosts /api/auth).
# clubedge:if auth=better-auth
BETTER_AUTH_URL=http://localhost:3000
# clubedge:end

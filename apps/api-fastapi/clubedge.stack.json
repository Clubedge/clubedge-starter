{
  "id": "fastapi",
  "name": "FastAPI (Python)",
  "role": "api",
  "envExample": ".env.example",
  "dockerfile": "Dockerfile",
  "conditional": [
    "Dockerfile",
    "src/clubedge_api/check_services.py",
    "src/clubedge_api/production_env.py"
  ],
  "deployment": {
    "id": "api",
    "port": 3001,
    "healthPath": "/api/health",
    "platforms": ["docker", "railway"]
  },
  "toolchain": {
    "name": "uv",
    "check": ["uv", "--version"],
    "install": ["uv", "sync", "--locked"],
    "url": "https://docs.astral.sh/uv/getting-started/installation/"
  },
  "modules": {
    "auth": {
      "none": {},
      "supabase": {
        "replace": {
          "src/clubedge_api/auth.py": "src/clubedge_api/variants/auth_supabase.py"
        }
      },
      "firebase": {
        "files": ["src/clubedge_api/variants/auth_firebase.py"],
        "replace": {
          "src/clubedge_api/auth.py": "src/clubedge_api/variants/auth_firebase.py"
        }
      },
      "appwrite": {
        "files": ["src/clubedge_api/variants/auth_appwrite.py"],
        "replace": {
          "src/clubedge_api/auth.py": "src/clubedge_api/variants/auth_appwrite.py"
        }
      },
      "better-auth": {
        "files": ["src/clubedge_api/variants/auth_better_auth.py"],
        "replace": {
          "src/clubedge_api/auth.py": "src/clubedge_api/variants/auth_better_auth.py"
        }
      }
    },
    "storage": {
      "none": {}
    },
    "cache": {
      "memory": {}
    },
    "email": {
      "none": {}
    },
    "payments": {
      "none": {}
    },
    "jobs": {
      "none": {}
    },
    "observability": {
      "none": {}
    },
    "deploy": {
      "docker": {},
      "railway": {}
    }
  }
}

{
  "name": "clubedge-starter-v1",
  "version": "0.30.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@clubedge/web",
    "build": "turbo run build",
    "start": "turbo run start --env-mode=loose --filter=@clubedge/web",
    "lint": "eslint . && turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm -r --if-present run db:generate",
    "db:migrate": "pnpm -r --if-present run db:migrate",
    "db:push": "pnpm --filter @clubedge/db db:push",
    "db:studio": "pnpm --filter @clubedge/db db:studio",
    "db:check": "pnpm -r --if-present run db:check",
    "db:seed": "pnpm --filter @clubedge/db db:seed",
    "test": "vitest run && turbo run test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "docker:dev": "docker compose -f docker-compose.yml up --build",
    "docker:build": "docker build -t clubedge-starter .",
    "docker:start": "docker run --rm -p 3000:3000 --env-file apps/web/.env.local clubedge-starter",
    "check:services": "pnpm --filter @clubedge/web check:services",
    "check:env": "pnpm --filter @clubedge/web check:env",
    "clubedge": "pnpm dlx @clubedge/create-clubedge-app@latest",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:reset": "docker compose -f docker-compose.dev.yml down --volumes",
    "infra:logs": "docker compose -f docker-compose.dev.yml logs --follow"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.6",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "^1.13.6",
      "esbuild": "^0.25.0",
      "fast-xml-parser": "^5.10.1",
      "undici@>=6.23.0 <6.29.1": "^6.29.1",
      "uuid@<11.1.1": "^11.1.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}

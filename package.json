{
  "name": "clubedge-starter-v1",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@clubedge/web",
    "build": "turbo run build --filter=@clubedge/web",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @clubedge/db db:generate",
    "db:migrate": "pnpm --filter @clubedge/db db:migrate",
    "db:push": "pnpm --filter @clubedge/db db:push",
    "db:studio": "pnpm --filter @clubedge/db db:studio",
    "db:check": "pnpm --filter @clubedge/db db:check",
    "db:seed": "pnpm --filter @clubedge/db db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "docker:dev": "docker compose up --build",
    "docker:build": "docker build -t clubedge-starter .",
    "docker:start": "docker run --rm -p 3000:3000 --env-file apps/web/.env.local clubedge-starter"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.6",
    "eslint": "^10.12.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0"
    }
  }
}

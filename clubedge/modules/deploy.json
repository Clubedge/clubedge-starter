{
  "name": "Deployment",
  "default": "docker",
  "options": {
    "docker": {
      "name": "Docker image, on any container host"
    },
    "fly": {
      "name": "Fly.io",
      "files": [".github/workflows/deploy.yml", "fly.toml"]
    },
    "railway": {
      "name": "Railway",
      "files": [".github/workflows/deploy.yml", ".railway/railway.ts"]
    },
    "render": {
      "name": "Render",
      "files": [".github/workflows/deploy.yml", "render.yaml"]
    },
    "vercel": {
      "name": "Vercel",
      "files": [".github/workflows/deploy.yml"]
    },
    "netlify": {
      "name": "Netlify",
      "files": [".github/workflows/deploy.yml"]
    },
    "cloudflare": {
      "name": "Cloudflare",
      "packages": {
        "@clubedge/deploy-cloudflare": "deploy/cloudflare"
      },
      "scripts": {
        "deploy:cloudflare": "pnpm --filter @clubedge/web build && pnpm --filter @clubedge/deploy-cloudflare run deploy",
        "deploy:cloudflare:website": "pnpm --filter @clubedge/web build && pnpm --filter @clubedge/deploy-cloudflare run deploy:website"
      }
    }
  }
}
